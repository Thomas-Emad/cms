{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/runable.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "rewrites": [
        {
            "source": "/",
            "destination": "/api/runable.php"
        },
        {
            "source": "/build/(.*)",
            "destination": "/public/build/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/api/runable.php"
        }
    ]
}